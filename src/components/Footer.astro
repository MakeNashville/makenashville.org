---
const base = import.meta.env.BASE_URL;
---
<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-info">
      <p class="footer-address">620b Davidson St, Nashville, TN 37213</p>
      <p><a href="mailto:info@makenashville.org">info@makenashville.org</a></p>
      <p class="footer-openhouse">Join us <a href="https://www.eventbrite.com/e/165415485169?aff=oddtdtcreator">every other Friday at 6 PM</a> at our open house to see the space and sign up for membership.</p>
    </div>

    <nav class="footer-nav" aria-label="Footer navigation">
      <ul role="list">
        <li><a href="https://www.eventbrite.com/o/make-nashville-9796500814">Classes</a></li>
        <li><a href={`${base}our-space/`}>Our Space</a></li>
        <li><a href={`${base}history/`}>Our History</a></li>
        <li><a href={`${base}get-involved/`}>Pricing</a></li>
        <li><a href={`${base}sponsors/`}>Sponsors</a></li>
        <li><a href="https://makenashville.slack.com">Slack</a></li>
        <li><a href="https://go.makenashville.org/sustaining">Donate</a></li>
        <li><a href="mailto:info@makenashville.org">Contact</a></li>
      </ul>
    </nav>

    <nav class="footer-social" aria-label="Social media links">
      <ul role="list">
        <li><a href="https://www.instagram.com/makenashville/" aria-label="Make Nashville on Instagram">Instagram</a></li>
        <li><a href="https://github.com/MakeNashville/" aria-label="Make Nashville on GitHub">GitHub</a></li>
        <li><a href="https://venmo.com/makenashville" aria-label="Make Nashville on Venmo">Venmo</a></li>
      </ul>
    </nav>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-bg-footer);
    color: var(--color-white);
    padding: var(--spacing-lg) 0;
    font-size: 0.9rem;
  }

  .footer-grid {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--spacing-md);
  }

  .footer-info {
    color: #aaaaaa;
  }

  .footer-info a {
    color: var(--color-white);
  }

  .footer-info a:hover {
    color: var(--color-white);
    text-decoration: underline;
  }

  .footer-info p {
    margin-bottom: var(--spacing-xs);
  }

  .footer-openhouse {
    margin-top: var(--spacing-sm);
  }

  .footer-nav ul {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-sm) var(--spacing-md);
  }

  .footer-nav a {
    color: #aaaaaa;
  }

  .footer-nav a:hover {
    color: var(--color-white);
  }

  .footer-social ul {
    list-style: none;
    display: flex;
    gap: var(--spacing-sm);
  }

  .footer-social a {
    color: #aaaaaa;
  }

  .footer-social a:hover {
    color: var(--color-white);
  }

  @media (max-width: 768px) {
    .footer-grid {
      flex-direction: column;
      gap: var(--spacing-md);
    }
  }
</style>
