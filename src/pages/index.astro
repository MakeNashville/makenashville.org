---
import BaseLayout from '../layouts/BaseLayout.astro';
import ShopCard from '../components/ShopCard.astro';
import Testimonial from '../components/Testimonial.astro';
import { getCollection } from 'astro:content';

const shops = (await getCollection('shops')).sort((a, b) => a.data.order - b.data.order);
const base = import.meta.env.BASE_URL;
---
<BaseLayout title="Make Nashville - Nashville's Community Makerspace">
  <div class="carousel" role="region" aria-label="Photos of Make Nashville shops">
    <input type="radio" name="carousel" id="slide-1" class="carousel-radio" checked aria-label="Slide 1: Woodshop" />
    <input type="radio" name="carousel" id="slide-2" class="carousel-radio" aria-label="Slide 2: Metal shop" />
    <input type="radio" name="carousel" id="slide-3" class="carousel-radio" aria-label="Slide 3: Main workspace" />
    <input type="radio" name="carousel" id="slide-4" class="carousel-radio" aria-label="Slide 4: Ceramics studio" />
    <input type="radio" name="carousel" id="slide-5" class="carousel-radio" aria-label="Slide 5: Auto shop" />
    <input type="radio" name="carousel" id="slide-6" class="carousel-radio" aria-label="Slide 6: Community" />

    <div class="carousel-track">
      <div class="carousel-slide">
        <img src={`${base}images/carousel/woodshop.webp`} alt="Woodshop with workbenches and tools" width="1400" height="500" />
      </div>
      <div class="carousel-slide">
        <img src={`${base}images/carousel/metalshop.webp`} alt="Metal shop with welding bays" width="1400" height="500" loading="lazy" />
      </div>
      <div class="carousel-slide">
        <img src={`${base}images/carousel/big-room.webp`} alt="Main workspace at Make Nashville" width="1400" height="500" loading="lazy" />
      </div>
      <div class="carousel-slide">
        <img src={`${base}images/carousel/ceramics.webp`} alt="Ceramics studio with pottery wheels" width="1400" height="500" loading="lazy" />
      </div>
      <div class="carousel-slide">
        <img src={`${base}images/carousel/autoshop.webp`} alt="Auto shop with vehicle lift" width="1400" height="500" loading="lazy" />
      </div>
      <div class="carousel-slide">
        <img src={`${base}images/carousel/community.webp`} alt="Make Nashville community gathering" width="1400" height="500" loading="lazy" />
      </div>
    </div>

    <div class="carousel-arrows">
      <div class="carousel-prev-group">
        <label for="slide-6" class="carousel-arrow s1-prev" aria-label="Previous slide">&#8249;</label>
        <label for="slide-1" class="carousel-arrow s2-prev" aria-label="Previous slide">&#8249;</label>
        <label for="slide-2" class="carousel-arrow s3-prev" aria-label="Previous slide">&#8249;</label>
        <label for="slide-3" class="carousel-arrow s4-prev" aria-label="Previous slide">&#8249;</label>
        <label for="slide-4" class="carousel-arrow s5-prev" aria-label="Previous slide">&#8249;</label>
        <label for="slide-5" class="carousel-arrow s6-prev" aria-label="Previous slide">&#8249;</label>
      </div>
      <div class="carousel-next-group">
        <label for="slide-2" class="carousel-arrow s1-next" aria-label="Next slide">&#8250;</label>
        <label for="slide-3" class="carousel-arrow s2-next" aria-label="Next slide">&#8250;</label>
        <label for="slide-4" class="carousel-arrow s3-next" aria-label="Next slide">&#8250;</label>
        <label for="slide-5" class="carousel-arrow s4-next" aria-label="Next slide">&#8250;</label>
        <label for="slide-6" class="carousel-arrow s5-next" aria-label="Next slide">&#8250;</label>
        <label for="slide-1" class="carousel-arrow s6-next" aria-label="Next slide">&#8250;</label>
      </div>
    </div>

    <div class="carousel-dots">
      <label for="slide-1" class="carousel-dot" aria-label="Go to slide 1"></label>
      <label for="slide-2" class="carousel-dot" aria-label="Go to slide 2"></label>
      <label for="slide-3" class="carousel-dot" aria-label="Go to slide 3"></label>
      <label for="slide-4" class="carousel-dot" aria-label="Go to slide 4"></label>
      <label for="slide-5" class="carousel-dot" aria-label="Go to slide 5"></label>
      <label for="slide-6" class="carousel-dot" aria-label="Go to slide 6"></label>
    </div>
  </div>

  <section class="hero">
    <div class="container">
      <h1>Make Nashville</h1>
      <p class="hero-tagline">Like a gym, but with tools for making stuff.</p>
      <p class="hero-subtitle">Make Nashville is a nonprofit makerspace where creativity comes to life in 12,000 square feet of workshops and endless possibility. Join our community of makers, fixers, artists, and hobbyists who turn "What if..." into "I made that!"</p>
      <a href={`${base}get-involved/`} class="btn btn--primary hero-cta">Join Us</a>
    </div>
  </section>

  <section class="section" aria-labelledby="shops-heading">
    <div class="container">
      <h2 id="shops-heading">Explore the creative spaces of Make Nashville</h2>
      <div class="shop-grid">
        {shops.map(shop => (
          <ShopCard
            title={shop.data.title}
            tagline={shop.data.tagline}
            image={shop.data.image}
            slug={shop.id}
          />
        ))}
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container feature-row">
      <img src={`${base}images/ceramic-circle.webp`} alt="Group of people standing around a table displaying handmade pottery pieces" class="circle-img" width="300" height="300" />
      <div class="feature-text">
        <blockquote>
          <p>"Having access to all the tools to make things is great, but I think my favorite part of Make Nashville is the people there. Being around creatives, having deep conversations, and learning from/sharing with all the folks there really makes for some great experiences!"</p>
          <cite>- Ralph, Make Nashville member</cite>
        </blockquote>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container feature-row feature-row--reverse">
      <img src={`${base}images/ice-cream-circle.webp`} alt="Two people smiling and holding waffle cones with ice cream" class="circle-img" width="300" height="300" />
      <div class="feature-text">
        <h2>Learn and connect through member-led classes</h2>
        <p>Whether you're a complete beginner or looking to master new techniques, our workshops are hands-on and led by members who are passionate about their craft. Sign up to connect with members and learn new skills.</p>
        <a href="https://www.eventbrite.com/o/make-nashville-9796500814" class="btn btn--primary">Classes</a>
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container feature-row">
      <img src={`${base}images/building-exterior.webp`} alt="Make Nashville makerspace building exterior with red metal roof" class="circle-img" width="300" height="300" />
      <div class="feature-text">
        <h2>A creative space</h2>
        <p>Located in the heart of Nashville, our 12,000 sq ft facility offers 24/7 access to members, making it easy to pop in and create whenever you like, whether that's at 2pm or 2am. Schedule a tour of the space to see what we're all about.</p>
        <a href={`${base}our-space/`} class="btn btn--primary">Our Space</a>
      </div>
    </div>
  </section>

  <section class="section membership-cta" aria-labelledby="membership-heading">
    <div class="container">
      <h2 id="membership-heading">Ready to join our community and start making?</h2>
      <p>Join other makers, inventors, artists, and doers. Your membership includes the space, you bring the supplies and ideas.</p>
      <a href={`${base}get-involved/`} class="btn btn--primary">Get Involved</a>
    </div>
  </section>
</BaseLayout>

<style>
  /* Carousel: CSS-only with radio buttons */
  .carousel {
    width: 100%;
    height: 500px;
    overflow: hidden;
    position: relative;
  }

  .carousel-radio {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border-width: 0;
  }

  .carousel-track {
    display: flex;
    width: 600%;
    height: 100%;
    transition: transform 0.5s ease;
  }

  .carousel-slide {
    width: calc(100% / 6);
    flex-shrink: 0;
  }

  .carousel-slide img {
    width: 100%;
    height: 500px;
    object-fit: cover;
    object-position: center 60%;
  }

  /* Slide positions */
  #slide-1:checked ~ .carousel-track { transform: translateX(0); }
  #slide-2:checked ~ .carousel-track { transform: translateX(-16.6667%); }
  #slide-3:checked ~ .carousel-track { transform: translateX(-33.3333%); }
  #slide-4:checked ~ .carousel-track { transform: translateX(-50%); }
  #slide-5:checked ~ .carousel-track { transform: translateX(-66.6667%); }
  #slide-6:checked ~ .carousel-track { transform: translateX(-83.3333%); }

  /* Arrows */
  .carousel-arrows {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    display: flex;
    justify-content: space-between;
    align-items: center;
    pointer-events: none;
    padding: 0 var(--spacing-sm);
  }

  .carousel-arrow {
    pointer-events: auto;
    background: rgba(0, 0, 0, 0.4);
    color: white;
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 2rem;
    line-height: 1;
    cursor: pointer;
    transition: background 0.2s;
    user-select: none;
  }

  .carousel-arrow:hover {
    background: rgba(0, 0, 0, 0.7);
  }

  /* Show only the correct prev/next arrow per slide */
  .carousel-arrow { display: none; }

  #slide-1:checked ~ .carousel-arrows .s1-prev,
  #slide-1:checked ~ .carousel-arrows .s1-next,
  #slide-2:checked ~ .carousel-arrows .s2-prev,
  #slide-2:checked ~ .carousel-arrows .s2-next,
  #slide-3:checked ~ .carousel-arrows .s3-prev,
  #slide-3:checked ~ .carousel-arrows .s3-next,
  #slide-4:checked ~ .carousel-arrows .s4-prev,
  #slide-4:checked ~ .carousel-arrows .s4-next,
  #slide-5:checked ~ .carousel-arrows .s5-prev,
  #slide-5:checked ~ .carousel-arrows .s5-next,
  #slide-6:checked ~ .carousel-arrows .s6-prev,
  #slide-6:checked ~ .carousel-arrows .s6-next {
    display: flex;
  }

  /* Dots */
  .carousel-dots {
    position: absolute;
    bottom: var(--spacing-sm);
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 0.5rem;
  }

  .carousel-dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.5);
    cursor: pointer;
    transition: background 0.2s;
  }

  .carousel-dot:hover {
    background: rgba(255, 255, 255, 0.8);
  }

  /* Active dot */
  #slide-1:checked ~ .carousel-dots label[for="slide-1"],
  #slide-2:checked ~ .carousel-dots label[for="slide-2"],
  #slide-3:checked ~ .carousel-dots label[for="slide-3"],
  #slide-4:checked ~ .carousel-dots label[for="slide-4"],
  #slide-5:checked ~ .carousel-dots label[for="slide-5"],
  #slide-6:checked ~ .carousel-dots label[for="slide-6"] {
    background: rgba(255, 255, 255, 1);
  }

  @media (prefers-reduced-motion: reduce) {
    .carousel-track {
      transition: none;
    }
  }

  @media (max-width: 768px) {
    .carousel {
      height: 300px;
    }
    .carousel-slide img {
      height: 300px;
    }
    .carousel-arrow {
      width: 2.5rem;
      height: 2.5rem;
      font-size: 1.5rem;
    }
  }

  .hero {
    text-align: center;
    padding: var(--spacing-xl) 0;
  }

  .hero h1 {
    font-size: 3.5rem;
    margin-bottom: var(--spacing-sm);
  }

  .hero-tagline {
    font-size: 1.25rem;
    color: var(--color-text-secondary);
    margin-bottom: var(--spacing-xs);
  }

  .hero-subtitle {
    font-size: 1rem;
    color: var(--color-text-muted);
    max-width: 600px;
    margin: 0 auto var(--spacing-md);
  }

  .hero-cta {
    margin-top: var(--spacing-sm);
  }

  .section h2 {
    text-align: center;
    margin-bottom: var(--spacing-md);
    font-size: 1.5rem;
  }

  .feature-row {
    display: flex;
    align-items: center;
    gap: var(--spacing-xl);
  }

  .feature-row--reverse {
    flex-direction: row-reverse;
  }

  .circle-img {
    border-radius: 50%;
    width: 280px;
    height: 280px;
    object-fit: cover;
    flex-shrink: 0;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
  }

  .feature-text {
    flex: 1;
  }

  .feature-text h2 {
    text-align: left;
    font-size: 1.5rem;
    margin-bottom: var(--spacing-sm);
  }

  .feature-text p {
    color: var(--color-text-muted);
    line-height: 1.7;
    margin-bottom: var(--spacing-md);
  }

  .feature-text blockquote p {
    font-style: italic;
    font-size: 1.1rem;
    color: var(--color-text-secondary);
    line-height: 1.7;
    margin-bottom: var(--spacing-sm);
  }

  .feature-text blockquote cite {
    color: var(--color-text-muted);
    font-style: normal;
    font-size: 0.9rem;
  }

  .membership-cta {
    text-align: center;
    padding: var(--spacing-xl) 0;
    background: var(--color-bg-alt);
  }

  .membership-cta h2 {
    font-size: 2rem;
  }

  .membership-cta p {
    color: var(--color-text-muted);
    margin-bottom: var(--spacing-md);
  }

  @media (max-width: 768px) {
    .feature-row,
    .feature-row--reverse {
      flex-direction: column;
      text-align: center;
    }

    .feature-text h2 {
      text-align: center;
    }

    .circle-img {
      width: 200px;
      height: 200px;
    }
  }

  @media (max-width: 600px) {
    .hero h1 {
      font-size: 2.5rem;
    }
  }
</style>
