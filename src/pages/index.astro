---
import BaseLayout from '../layouts/BaseLayout.astro';
import ShopCard from '../components/ShopCard.astro';
import Testimonial from '../components/Testimonial.astro';
import { getCollection } from 'astro:content';

const shops = (await getCollection('shops')).sort((a, b) => a.data.order - b.data.order);
const base = import.meta.env.BASE_URL;
---
<BaseLayout title="Make Nashville">
  <div class="carousel" role="region" aria-label="Photos of Make Nashville shops">
    <div class="carousel-track">
      <img src={`${base}images/carousel/woodshop.webp`} alt="Woodshop with workbenches and tools" width="1400" height="500" />
      <img src={`${base}images/carousel/metalshop.webp`} alt="Metal shop with welding bays" width="1400" height="500" />
      <img src={`${base}images/carousel/big-room.webp`} alt="Main workspace at Make Nashville" width="1400" height="500" />
      <img src={`${base}images/carousel/ceramics.webp`} alt="Ceramics studio with pottery wheels" width="1400" height="500" />
      <img src={`${base}images/carousel/autoshop.webp`} alt="Auto shop with vehicle lift" width="1400" height="500" />
      <img src={`${base}images/carousel/community.webp`} alt="Make Nashville community gathering" width="1400" height="500" />
      <img src={`${base}images/carousel/woodshop.webp`} alt="" aria-hidden="true" width="1400" height="500" />
    </div>
  </div>

  <section class="hero">
    <div class="container">
      <h1>Make Nashville</h1>
      <p class="hero-tagline">Like a gym, but with tools for making stuff.</p>
      <p class="hero-subtitle">12,000 square feet of shops and endless possibility. Welcome makers, fixers, artists, and hobbyists.</p>
      <a href="https://members.makenashville.org/civicrm/contribute/transact/?reset=1&id=19" class="btn btn--primary hero-cta">Join Us</a>
    </div>
  </section>

  <section class="section" aria-labelledby="shops-heading">
    <div class="container">
      <h2 id="shops-heading">Explore the creative spaces of Make Nashville</h2>
      <div class="shop-grid">
        {shops.map(shop => (
          <ShopCard
            title={shop.data.title}
            tagline={shop.data.tagline}
            image={shop.data.image}
            slug={shop.id}
          />
        ))}
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container feature-row">
      <img src={`${base}images/ceramic-circle.webp`} alt="Group of people standing around a table displaying handmade pottery pieces" class="circle-img" width="300" height="300" />
      <div class="feature-text">
        <blockquote>
          <p>"Having access to all the tools to make things is great, but the best thing about Make Nashville is the people there... creatives sharing knowledge and experiences."</p>
          <cite>- Ralph, Make Nashville member</cite>
        </blockquote>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container feature-row feature-row--reverse">
      <img src={`${base}images/ice-cream-circle.webp`} alt="Two people smiling and holding waffle cones with ice cream" class="circle-img" width="300" height="300" />
      <div class="feature-text">
        <h2>Learn and connect through member-led classes</h2>
        <p>Our members teach classes on everything from woodworking to electronics. Browse upcoming classes and sign up on Eventbrite.</p>
        <a href="https://www.eventbrite.com/o/make-nashville-9796500814" class="btn btn--primary">Classes</a>
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container feature-row">
      <img src={`${base}images/building-circle.webp`} alt="Make Nashville building exterior with red metal roof and parked cars" class="circle-img" width="300" height="300" />
      <div class="feature-text">
        <h2>It's more than tools, it's a community</h2>
        <p>Connect with fellow makers 24/7 on Slack, at open houses every other Friday, and through community events. Make Nashville is volunteer-run and member-driven.</p>
        <a href={`${base}get-involved/`} class="btn btn--primary">Get Involved</a>
      </div>
    </div>
  </section>

  <section class="section membership-cta" aria-labelledby="membership-heading">
    <div class="container">
      <h2 id="membership-heading">$75/month</h2>
      <p>No contract. Cancel anytime. 18+ with valid photo ID.</p>
      <a href="https://members.makenashville.org/civicrm/contribute/transact/?reset=1&id=19" class="btn btn--primary">Join Us</a>
    </div>
  </section>
</BaseLayout>

<style>
  .carousel {
    width: 100%;
    height: 500px;
    overflow: hidden;
    position: relative;
  }

  .carousel-track {
    display: flex;
    width: calc(1400px * 7);
    animation: scroll 30s linear infinite;
  }

  .carousel-track img {
    width: 100vw;
    height: 500px;
    object-fit: cover;
    flex-shrink: 0;
  }

  @keyframes scroll {
    0% { transform: translateX(0); }
    14.28% { transform: translateX(0); }
    16.66% { transform: translateX(-100vw); }
    30.94% { transform: translateX(-100vw); }
    33.32% { transform: translateX(-200vw); }
    47.60% { transform: translateX(-200vw); }
    49.98% { transform: translateX(-300vw); }
    64.26% { transform: translateX(-300vw); }
    66.64% { transform: translateX(-400vw); }
    80.92% { transform: translateX(-400vw); }
    83.30% { transform: translateX(-500vw); }
    97.58% { transform: translateX(-500vw); }
    100% { transform: translateX(-600vw); }
  }

  @media (prefers-reduced-motion: reduce) {
    .carousel-track {
      animation: none;
    }
    .carousel {
      height: auto;
    }
    .carousel-track {
      flex-direction: column;
      width: 100%;
    }
    .carousel-track img {
      width: 100%;
      height: auto;
    }
    .carousel-track img:not(:first-child) {
      display: none;
    }
  }

  @media (max-width: 768px) {
    .carousel {
      height: 300px;
    }
    .carousel-track img {
      height: 300px;
    }
  }

  .hero {
    text-align: center;
    padding: var(--spacing-xl) 0;
  }

  .hero h1 {
    font-size: 3rem;
    margin-bottom: var(--spacing-sm);
  }

  .hero-tagline {
    font-size: 1.25rem;
    color: var(--color-text-secondary);
    margin-bottom: var(--spacing-xs);
  }

  .hero-subtitle {
    font-size: 1rem;
    color: var(--color-text-muted);
    max-width: 600px;
    margin: 0 auto var(--spacing-md);
  }

  .hero-cta {
    margin-top: var(--spacing-sm);
  }

  .section h2 {
    text-align: center;
    margin-bottom: var(--spacing-md);
    font-size: 1.5rem;
  }

  .feature-row {
    display: flex;
    align-items: center;
    gap: var(--spacing-xl);
  }

  .feature-row--reverse {
    flex-direction: row-reverse;
  }

  .circle-img {
    border-radius: 50%;
    width: 280px;
    height: 280px;
    object-fit: cover;
    flex-shrink: 0;
  }

  .feature-text {
    flex: 1;
  }

  .feature-text h2 {
    text-align: left;
    font-size: 1.5rem;
    margin-bottom: var(--spacing-sm);
  }

  .feature-text p {
    color: var(--color-text-muted);
    line-height: 1.7;
    margin-bottom: var(--spacing-md);
  }

  .feature-text blockquote p {
    font-style: italic;
    font-size: 1.1rem;
    color: var(--color-text-secondary);
    line-height: 1.7;
    margin-bottom: var(--spacing-sm);
  }

  .feature-text blockquote cite {
    color: var(--color-text-muted);
    font-style: normal;
    font-size: 0.9rem;
  }

  .membership-cta {
    text-align: center;
    padding: var(--spacing-xl) 0;
    background: var(--color-bg-alt);
  }

  .membership-cta h2 {
    font-size: 2rem;
  }

  .membership-cta p {
    color: var(--color-text-muted);
    margin-bottom: var(--spacing-md);
  }

  @media (max-width: 768px) {
    .feature-row,
    .feature-row--reverse {
      flex-direction: column;
      text-align: center;
    }

    .feature-text h2 {
      text-align: center;
    }

    .circle-img {
      width: 200px;
      height: 200px;
    }
  }

  @media (max-width: 600px) {
    .hero h1 {
      font-size: 2rem;
    }
  }
</style>
