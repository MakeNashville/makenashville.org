---
import BaseLayout from '../layouts/BaseLayout.astro';
import ShopDetail from '../components/ShopDetail.astro';
import Testimonial from '../components/Testimonial.astro';
import { getCollection, render } from 'astro:content';
import floorPlanSvg from '../../public/images/raw-floor.svg?raw';

const shops = (await getCollection('shops')).sort((a, b) => a.data.order - b.data.order);
const base = import.meta.env.BASE_URL;

const shopsWithContent = await Promise.all(
  shops.map(async (shop) => {
    const { Content } = await render(shop);
    return { shop, Content };
  })
);
---
<BaseLayout title="Our Space - Make Nashville" description="Explore Make Nashville's 12 specialized shops, from woodworking and metalwork to ceramics, 3D printing, and more.">
  <div class="hero-image">
    <img src={`${base}images/building-exterior.webp`} alt="Make Nashville makerspace building exterior with red metal roof" width="1400" height="500" />
  </div>

  <section class="hero">
    <div class="container">
      <h1>Many specialized workshops all under one roof</h1>
      <p class="hero-subtitle">From precision woodworking to experimental electronics, every corner of Make Nashville is built to inspire our community. Discover where your next project will come to life.</p>
    </div>
  </section>

  <section class="section floor-plan-section">
    <div class="container">
      <div class="floor-plan" set:html={floorPlanSvg} />
      <nav class="sr-only" aria-label="Jump to shop">
        <ul>
          {shops.map(shop => (
            <li><a href={`#${shop.id}`}>{shop.data.title}</a></li>
          ))}
        </ul>
      </nav>
    </div>
  </section>

  <section class="section" aria-labelledby="shops-heading">
    <div class="container">
      <h2 class="sr-only" id="shops-heading">Our Shops</h2>
      {shopsWithContent.map(({ shop, Content }) => (
        <ShopDetail
          id={shop.id}
          title={shop.data.title}
          tagline={shop.data.tagline}
          image={shop.data.image}
          equipment={shop.data.equipment}
          orientationRequired={shop.data.orientationRequired}
          content={Content}
        />
      ))}
    </div>
  </section>

  <Testimonial
    quote="For social anxiety peeps: I've been a member of other maker spaces and I always felt like an outsider. From the moment I joined Make Nashville, the Slack channel immediately helped me feel like I was part of the community. Then visiting the space. I felt like I was back in college art classes. There's a relaxed, creative vibe that feels familiar."
    attribution="Jenny, Make Nashville member"
  />

  <section class="section cta-section">
    <div class="container">
      <h2>Find your people and your next project</h2>
      <p>These tools are just the beginning. The real magic is connecting with other people to inspire and create. Join a community where your ideas have room to grow, your skills have space to develop, and your creativity has the people to support it.</p>
      <a href={`${base}get-involved/`} class="btn btn--primary">Get Involved</a>
    </div>
  </section>
</BaseLayout>

<style>
  .hero-image {
    overflow: hidden;
  }

  .hero-image img {
    width: 100%;
    height: 400px;
    object-fit: cover;
    object-position: center;
    scale: 1.08;
  }

  .hero {
    text-align: center;
    padding: var(--spacing-lg) 0;
  }

  .hero h1 {
    font-size: 2rem;
    margin-bottom: var(--spacing-xs);
  }

  .hero-subtitle {
    color: var(--color-text-dim);
  }

  .floor-plan-section {
    padding: 0 0 var(--spacing-md);
  }

  .floor-plan {
    border-radius: 10px;
    box-shadow: 0 5px 20px rgba(0, 0, 0, 0.05);
    overflow: hidden;
  }

  .floor-plan :global(svg) {
    display: block;
    width: 100%;
    height: auto;
  }

  .floor-plan :global(.shop-link) {
    cursor: pointer;
  }

  .floor-plan :global(.shop-link text) {
    fill: var(--color-accent);
    font-weight: 700;
    text-decoration: underline;
    transition: fill 0.15s ease;
  }

  .floor-plan :global(.shop-link:hover text),
  .floor-plan :global(.shop-link:focus-visible text) {
    fill: #8a0a1f;
  }

  .floor-plan :global(.shop-link:focus) {
    outline: none;
  }

  .floor-plan :global(.shop-link:focus-visible) {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
    border-radius: 2px;
  }

  .cta-section {
    text-align: center;
    background: var(--color-bg-alt);
  }

  .cta-section p {
    color: var(--color-text-muted);
    max-width: 700px;
    margin: 0 auto var(--spacing-md);
    line-height: 1.7;
  }
</style>
