---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Calendar - Make Nashville" description="Upcoming classes, workshops, and open houses at Make Nashville.">
  <section class="hero">
    <div class="container">
      <h1>Upcoming Classes & Events</h1>
      <p class="hero-subtitle">Member-led workshops and open houses</p>
    </div>
  </section>

  <section class="section" aria-labelledby="events-heading">
    <div class="container">
      <h2 class="sr-only" id="events-heading">Events</h2>
      <div class="eventbrite-cta">
        <p>Browse upcoming classes, workshops, and open houses on Eventbrite.</p>
        <a href="https://www.eventbrite.com/o/make-nashville-9796500814" class="btn btn--primary">View Events on Eventbrite</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    text-align: center;
    padding: var(--spacing-lg) 0;
  }

  .hero h1 {
    font-size: 2rem;
    margin-bottom: var(--spacing-xs);
  }

  .hero-subtitle {
    color: var(--color-text-dim);
  }

  .eventbrite-cta {
    text-align: center;
    padding: var(--spacing-xl);
    background: var(--color-white);
    border-radius: 10px;
    box-shadow: 0 5px 20px rgba(0, 0, 0, 0.05);
  }

  .eventbrite-cta p {
    color: var(--color-text-muted);
    margin-bottom: var(--spacing-md);
    font-size: 1.1rem;
  }
</style>
