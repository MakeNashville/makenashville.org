---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Calendar - Make Nashville" description="Upcoming classes, workshops, and open houses at Make Nashville.">
  <section class="hero">
    <div class="container">
      <h1>Events Calendar</h1>
      <p class="hero-subtitle">This calendar shows all formal classes and workshops at Make Nashville. Some classes are open to the public, while others (including all orientations) are available for members only. Be sure to follow the details of each event to see if it's ticketed or requires membership.</p>
    </div>
  </section>

  <section class="section" aria-labelledby="events-heading">
    <div class="container">
      <h2 class="sr-only" id="events-heading">Events</h2>
      <div class="calendar-embed">
        <div data-events-calendar-app data-project-id="proj_gPG5q07rN4QaZFuMM4fwX"></div>
      </div>
    </div>
  </section>
</BaseLayout>

<script is:inline type="text/javascript" src="https://dist.eventscalendar.co/embed.js"></script>

<style>
  .hero {
    text-align: center;
    padding: var(--spacing-lg) 0;
  }

  .hero h1 {
    font-size: 2rem;
    margin-bottom: var(--spacing-sm);
  }

  .hero-subtitle {
    color: var(--color-text-muted);
    max-width: 700px;
    margin: 0 auto;
    line-height: 1.7;
  }

  .calendar-embed {
    min-height: 600px;
  }
</style>
