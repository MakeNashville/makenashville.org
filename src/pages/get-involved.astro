---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const shops = (await getCollection('shops')).sort((a, b) => a.data.order - b.data.order);
const orientationRequired = shops.filter(s => s.data.orientationRequired);
const openAccess = shops.filter(s => !s.data.orientationRequired);
---
<BaseLayout title="Get Involved - Make Nashville" description="Join Make Nashville for $75/month. Learn about membership, volunteering, donations, and policies.">
  <section class="hero">
    <div class="container">
      <h1>Membership</h1>
      <p class="price">$75/month</p>
      <p class="hero-subtitle">No contract. Cancel anytime. 18+ with valid photo ID.</p>
      <p class="hero-desc">Get full access to our workshops, 24/7 facility access, community Slack channel, and member-led community and safety orientations. Your membership supports our mission to keep creative tools accessible to the Nashville community.</p>
    </div>
  </section>

  <section class="section" aria-labelledby="includes-heading">
    <div class="container">
      <h2 id="includes-heading">What's Included</h2>
      <ul class="includes-list" role="list">
        <li>Key fob for 24/7 facility access</li>
        <li>Tool access after safety training</li>
        <li>Slack community membership</li>
        <li>Member-led community and safety orientations</li>
      </ul>
    </div>
  </section>

  <section class="section section--alt" aria-labelledby="join-heading">
    <div class="container">
      <h2 id="join-heading">How to Join</h2>
      <ol class="steps" role="list">
        <li>
          <span class="step-number">1</span>
          <div>
            <strong>Visit During Our Open House</strong>
            <p>Join us for our bi-weekly open house where you can tour all the workshops, meet current members, and see projects in progress.</p>
            <a href="https://www.eventbrite.com/e/165415485169?aff=oddtdtcreator" class="btn btn--primary">RSVP on Eventbrite</a>
          </div>
        </li>
        <li>
          <span class="step-number">2</span>
          <div>
            <strong>Complete Paperwork & Payment</strong>
            <p>Fill out a membership agreement and set up your monthly payment. We'll get you added to our access system and community Slack channel.</p>
          </div>
        </li>
        <li>
          <span class="step-number">3</span>
          <div>
            <strong>Complete Orientations</strong>
            <p>Before using equipment, you'll need to complete orientation for workshop areas you want access to, accessible through Eventbrite. These sessions cover safety protocols, tool access, and community guidelines.</p>
          </div>
        </li>
      </ol>
    </div>
  </section>

  <section class="section" aria-labelledby="access-heading">
    <div class="container">
      <h2 id="access-heading">Shop Access</h2>
      <div class="access-grid">
        <div class="access-card">
          <h3>Orientation Required</h3>
          <ul role="list">
            {orientationRequired.map(shop => <li>{shop.data.title}</li>)}
          </ul>
        </div>
        <div class="access-card">
          <h3>Open Access</h3>
          <ul role="list">
            {openAccess.map(shop => <li>{shop.data.title}</li>)}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--alt" aria-labelledby="contribute-heading">
    <div class="container">
      <h2 id="contribute-heading">Give Back</h2>
      <div class="contribute-grid">
        <div class="contribute-card">
          <h3>Volunteer</h3>
          <p>Make Nashville employs two paid staff members. The daily maintenance, care, and leadership of the space is volunteer-based. As members, we join the community to pitch in and help in the upkeep of the space. We always recommend members volunteer sustainably. Also, you can choose to add an additional monthly contribution to support our efforts.</p>
        </div>
        <div class="contribute-card">
          <h3>Donate</h3>
          <p>Support the space through monetary donations via our <a href="https://go.makenashville.org/sustaining">contribution page</a>, <a href="https://venmo.com/makenashville">Venmo</a>, or write a check to "Make Nashville." Physical donations of items must first go through an approval process that includes the shop captain. While we certainly appreciate the thought, we don't accept physical donations of equipment unless discussed with a board member, staff, or shop captain.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="faq-heading">
    <div class="container">
      <h2 id="faq-heading">Extended FAQs</h2>
      <div class="faq">
        <details class="faq-item">
          <summary>Who can join Make Nashville?</summary>
          <p>Anyone 18 years or older with a valid photo ID can become a member of Make Nashville.</p>
        </details>
        <details class="faq-item">
          <summary>What does membership include?</summary>
          <p>Membership includes 24/7 facility access via key fob, tool access after safety training, Slack community membership, and member-led community and safety orientations.</p>
        </details>
        <details class="faq-item">
          <summary>Can I use the shops immediately after joining?</summary>
          <p>The following studios don't require orientations: crafts, sewing, 3D printing, electronics, photo studio and darkroom. All other shops require an orientation before use.</p>
        </details>
        <details class="faq-item">
          <summary>How much does a Make Nashville membership cost?</summary>
          <p>Membership is $75/month, auto-billed monthly with no long-term contract. There is no pro-rating for partial months. You can cancel anytime.</p>
        </details>
        <details class="faq-item">
          <summary>What can I expect to learn during a bi-weekly open house event?</summary>
          <p>During our bi-weekly open house, you'll get a tour of all the workshops, meet current members, see projects in progress, and learn about the membership process.</p>
        </details>
        <details class="faq-item">
          <summary>How do I cancel or pause my membership?</summary>
          <p>You can cancel your membership at any time. There are no long-term contracts or cancellation fees. Contact us at info@makenashville.org to cancel.</p>
        </details>
        <details class="faq-item">
          <summary>Where can I find and register for workshops?</summary>
          <p>All classes and workshops are listed on our <a href="https://www.eventbrite.com/o/make-nashville-9796500814">Eventbrite page</a>. Spaces fill quickly, so sign up early.</p>
        </details>
        <details class="faq-item">
          <summary>Is parking available at Make Nashville?</summary>
          <p>Park in front of the building, but not in front of Bradfield Lighting. Members may also park on the side of the building inside the gated area using their key fob. There is no long term parking or vehicle storage.</p>
        </details>
        <details class="faq-item">
          <summary>How can I contribute to Make Nashville once I join?</summary>
          <p>Make Nashville is volunteer-run. The daily maintenance, care, and leadership of the space is volunteer-based. We always recommend members volunteer sustainably. You can also choose to add an additional monthly contribution to support our efforts.</p>
        </details>
        <details class="faq-item">
          <summary>Can I make a donation to Make Nashville?</summary>
          <p>Yes! You can make monetary donations via our <a href="https://go.makenashville.org/sustaining">contribution page</a>, <a href="https://venmo.com/makenashville">Venmo</a>, or write a check to "Make Nashville." Physical donations of items must first go through an approval process with a shop captain.</p>
        </details>
        <details class="faq-item">
          <summary>Are guests allowed in the makerspace?</summary>
          <p>You can bring guests into the makerspace, but each guest must sign a liability waiver to enter the space. Liability waivers are posted with a QR code at each entrance. Guests can assist in a member's activities, but must be accompanied by a member at all times.</p>
        </details>
        <details class="faq-item">
          <summary>Are children allowed in the makerspace?</summary>
          <p>Children are allowed in the makerspace, excluding dangerous shops (wood shop, metal shop, automotive). Every child accompanying a member must have a liability waiver signed by the adult accompanying them.</p>
        </details>
        <details class="faq-item">
          <summary>Are dogs allowed in the makerspace?</summary>
          <p>Dogs are allowed in the makerspace. If any member is made uncomfortable by their behavior, the owner may be asked to remove their dog from the makerspace.</p>
        </details>
      </div>
      <p class="faq-contact">Still have questions? Email us at <a href="mailto:info@makenashville.org">info@makenashville.org</a> or attend an open house.</p>
    </div>
  </section>

  <section class="section section--alt cta-section">
    <div class="container">
      <h2>Ready to make something?</h2>
      <a href="https://members.makenashville.org/civicrm/contribute/transact/?reset=1&id=19" class="btn btn--primary">Join Us</a>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    text-align: center;
    padding: var(--spacing-xl) 0;
  }

  .hero h1 {
    font-size: 2.5rem;
    margin-bottom: var(--spacing-sm);
  }

  .price {
    font-size: 2rem;
    font-weight: 700;
    font-family: var(--font-heading);
    color: var(--color-accent);
    margin-bottom: var(--spacing-sm);
  }

  .hero-subtitle {
    color: var(--color-text-muted);
    font-size: 1.1rem;
  }

  .hero-desc {
    color: var(--color-text-secondary);
    max-width: 650px;
    margin: var(--spacing-sm) auto 0;
    line-height: 1.7;
  }

  .section {
    padding: var(--spacing-xl) 0;
  }

  .section h2 {
    font-size: 1.75rem;
    margin-bottom: var(--spacing-lg);
    text-align: center;
  }

  .includes-list {
    list-style: none;
    max-width: 500px;
    margin: 0 auto;
  }

  .includes-list li {
    padding: var(--spacing-sm) 0;
    border-bottom: 1px solid var(--color-border);
    color: var(--color-text-secondary);
    font-size: 1.05rem;
  }

  .includes-list li:last-child {
    border-bottom: none;
  }

  .steps {
    list-style: none;
    max-width: 650px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: var(--spacing-lg);
  }

  .steps li {
    display: flex;
    gap: var(--spacing-md);
    align-items: flex-start;
  }

  .step-number {
    background: var(--color-accent);
    color: var(--color-white);
    border-radius: 50%;
    width: 2.5rem;
    height: 2.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1.1rem;
    flex-shrink: 0;
  }

  .steps strong {
    font-size: 1.1rem;
    display: block;
    margin-bottom: 0.25rem;
  }

  .steps p {
    color: var(--color-text-muted);
    margin: 0.25rem 0 var(--spacing-sm);
    font-size: 1rem;
    line-height: 1.6;
  }

  .access-grid,
  .contribute-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--spacing-md);
  }

  .access-card,
  .contribute-card {
    background: var(--color-white);
    box-shadow: 0 5px 20px rgba(0, 0, 0, 0.05);
    border-radius: 10px;
    padding: var(--spacing-lg) var(--spacing-md);
  }

  .access-card h3,
  .contribute-card h3 {
    font-size: 1.2rem;
    margin-bottom: var(--spacing-sm);
  }

  .access-card ul {
    list-style: none;
  }

  .access-card li {
    padding: 0.4rem 0;
    color: var(--color-text-secondary);
    font-size: 1rem;
  }

  .contribute-card p {
    color: var(--color-text-muted);
    line-height: 1.7;
    font-size: 1rem;
  }

  .faq {
    max-width: 700px;
    margin: 0 auto;
  }

  .faq-item {
    border-bottom: 1px solid var(--color-border);
  }

  .faq-item:last-child {
    border-bottom: none;
  }

  .faq-item summary {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1.1rem;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    padding: var(--spacing-md) 0;
    cursor: pointer;
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .faq-item summary::after {
    content: '+';
    font-size: 1.5rem;
    font-weight: 300;
    color: var(--color-text-muted);
    transition: transform 0.2s;
  }

  .faq-item[open] summary::after {
    content: '-';
  }

  .faq-item summary::-webkit-details-marker {
    display: none;
  }

  .faq-item p {
    color: var(--color-text-muted);
    line-height: 1.6;
    padding-bottom: var(--spacing-md);
  }

  .faq-contact {
    text-align: center;
    color: var(--color-text-muted);
    margin-top: var(--spacing-lg);
    font-size: 1rem;
  }

  .cta-section {
    text-align: center;
    padding: var(--spacing-xl) 0;
  }

  .cta-section h2 {
    font-size: 2rem;
    margin-bottom: var(--spacing-md);
  }

  @media (max-width: 600px) {
    .access-grid,
    .contribute-grid {
      grid-template-columns: 1fr;
    }

    .hero h1 {
      font-size: 2rem;
    }

    .section {
      padding: var(--spacing-lg) 0;
    }
  }
</style>
